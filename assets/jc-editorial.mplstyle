# jc-editorial.mplstyle · marca JC. v1.1 · gráficos editoriales sobre blanco
figure.facecolor: FFFFFF
axes.facecolor: FFFFFF
savefig.facecolor: FFFFFF
axes.edgecolor: 4B463E
axes.linewidth: 0.8
axes.spines.top: False
axes.spines.right: False
axes.spines.left: False
axes.spines.bottom: True
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
grid.color: 1F1B16
grid.alpha: 0.12
grid.linewidth: 0.6
axes.prop_cycle: cycler('color', ['2B3A2A', '6B7553', '8B9472', '4B463E'])
font.family: sans-serif
font.sans-serif: Geist, Arial, Liberation Sans, DejaVu Sans
font.size: 12
text.color: 1F1B16
axes.labelcolor: 4B463E
axes.labelsize: 11
axes.titlelocation: left
axes.titlesize: 16
axes.titleweight: semibold
axes.titlepad: 16
xtick.color: 4B463E
ytick.color: 4B463E
xtick.labelsize: 11
ytick.labelsize: 11
xtick.major.size: 0
ytick.major.size: 0
legend.frameon: False
legend.fontsize: 11
lines.linewidth: 2.2
figure.dpi: 150
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.25
